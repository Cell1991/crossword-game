# Ngrok Authentication & Custom Domain Configuration
# 1. Get your free authtoken at: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=

# 2. (Optional) Claim 1 free static custom domain at: https://dashboard.ngrok.com/domains
# Example: https://my-crossword-game.ngrok-free.app
# If left empty, ngrok will automatically assign a random URL.
NGROK_DOMAIN=
